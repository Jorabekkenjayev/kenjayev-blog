# Kenjayev BLOG & Telegram Bot Environment Variables
# NUQTA: bu fayl faqat namuna. Haqiqiy token/parollarni bu yozmang — .env fayliga yozing.

# Web Server Configuration
PORT=8080
ADMIN_LOGIN=+998XXXXXXXXX
ADMIN_PASSWORD=o'zingizning_maxfiy_parolingiz
ADMIN_SALT=o'zingizning_salt_qiymati
SESSION_SECRET=o'zingizning_uzun_maxfiy_kalit

# Telegram Bot Configuration
BOT_TOKEN=0123456789:AA...BOT_FATHER_TOKEN...
GUARD_BOT_TOKEN=0123456789:AA...GUARD_BOT_TOKEN...
ADMIN_CHAT_ID=123456789

# Mini App manzili — Flask/quiz ilovasi joylashgan REAL URL
# (kenjayev.uz alohida PHP sayt, u yerda quiz yo'q)
WEB_APP_URL=https://kenjayev-blog.onrender.com

# Bot username'lari (getMe ishlamagan holat uchun zaxira)
MAIN_BOT_USERNAME=KenjayevJorabekBot
GUARD_BOT_USERNAME=Botlarni_tekshiruvchi_Bot

# Sticker file_id'lari (ixtiyoriy). Bo'sh qolsa sticker yuborilmaydi.
# Olish usuli: botga stickerni yuboring -> bot file_id ni qaytaradi.
# Admin bo'lsangiz, caption bilan yuborsangiz avtomatik saqlanadi:
#   welcome | register | correct | wrong | rating | reply
STICKER_WELCOME=
STICKER_REGISTER=
STICKER_CORRECT=
STICKER_WRONG=
STICKER_RATING=
STICKER_REPLY=

# Webhook ishlatilsa (polling avtomatik o'chadi):
# TELEGRAM_WEBHOOK_SECRET=ixtiyoriy_uzun_kalit

# Optional: Cloud PostgreSQL (Supabase / Neon / Render Postgres)
# Render restart bo'lganda ballar saqlanib qolishi uchun shart.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
